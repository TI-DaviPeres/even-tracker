# Postgres. Qualquer Postgres serve — o driver é o `pg` comum.
#
# Opção A (recomendada), container do docker-compose.yml:
#
#   docker compose up -d
#   cp .env.example .env.local
#   npm run db:push
#
# Usuário, senha e base são todos "quites" — é banco descartável de desenvolvimento.
DATABASE_URL=postgresql://quites:quites@localhost:5433/quites

# Opção B: apontar direto para o Neon com `npx vercel env pull .env.local`.
# Cuidado, é o banco de produção — dados de teste e cota de compute são os reais.
#
# Em produção (Vercel) a integração Neon do Marketplace injeta esta variável
# sozinha, com a string POOLED (host contém "-pooler"). A string DIRECT, sem
# "-pooler", é usada só uma vez para criar as tabelas:
#
#   DATABASE_URL="<direct>" npm run db:push:remote
